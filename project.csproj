<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DarknessNotExcluded.mod</AssemblyName>
    <RootNamespace>DarknessNotExcluded</RootNamespace>
    <Version>1.4.1</Version>
    <AssemblyVersion>1.4.1.0</AssemblyVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GameLibsDir Condition="'$(GameLibsDir)' == ''">E:\SteamLibrary\steamapps\common\OxygenNotIncluded\OxygenNotIncluded_Data\Managed</GameLibsDir>
    <NoWarn>CS0649</NoWarn>
    <PackageDir>$(MSBuildProjectDirectory)\bin\$(Configuration)\$(TargetFramework)\package</PackageDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <PackageReference Include="PLib" Version="4.19.0" />
    <PackageReference Include="ILRepack" Version="2.0.44" PrivateAssets="all" />
    <Reference Include="$(GameLibsDir)\Newtonsoft.Json.dll" />
    <Reference Include="$(GameLibsDir)\0Harmony.dll" />
    <Reference Include="$(GameLibsDir)\Assembly-CSharp.dll" />
    <Reference Include="$(GameLibsDir)\Assembly-CSharp-firstpass.dll" />
    <Reference Include="$(GameLibsDir)\Unity.TextMeshPro.dll" />
    <Reference Include="$(GameLibsDir)\UnityEngine.CoreModule.dll" />
    <Reference Include="$(GameLibsDir)\UnityEngine.TextCoreTextEngineModule.dll" />
    <Reference Include="$(GameLibsDir)\UnityEngine.TextRenderingModule.dll" />
    <Reference Include="$(GameLibsDir)\UnityEngine.UI.dll" />
    <Reference Include="$(GameLibsDir)\UnityEngine.UIModule.dll" />
  </ItemGroup>
  <Target Name="Package" AfterTargets="Build">
    <MakeDir Directories="$(PackageDir)" />
    <Exec Command="&quot;$(ILRepack)&quot; /internalize /lib:&quot;$(GameLibsDir)&quot; /lib:&quot;$(TargetDir).&quot; /out:&quot;$(PackageDir)\DarknessNotExcluded.dll&quot; &quot;$(TargetPath)&quot; &quot;$(TargetDir)PLib.dll&quot;" />
    <Copy SourceFiles="mod.yaml;mod_info.yaml;preview.png" DestinationFolder="$(PackageDir)" />
  </Target>
</Project>
